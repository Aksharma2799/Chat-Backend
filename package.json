{
  "name": "chat-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Chat backend using Node.js, TypeScript, PostgreSQL and Firebase Firestore",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "dev": "npm run build && node --watch --env-file=.env dist/server.js"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
